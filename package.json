{
  "name": "mom-todo",
  "productName": "MoM",
  "version": "1.0.1",
  "description": "MoM, the Mechatronics Course Union's desk robot: a to-do list that lives in the corner of your screen.",
  "main": "src/main.js",
  "author": "Subhan Sajadi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "art": "electron scripts/make-art.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.subhansajadi.mom",
    "productName": "MoM",
    "copyright": "Copyright © 2026 Subhan Sajadi · Mechatronics Course Union, Toronto Metropolitan University",
    "directories": {
      "output": "dist.nosync",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!**/.DS_Store",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "subhansajadi",
        "repo": "mom-todo",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "MoM-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "MoM-mac-${arch}.dmg",
      "title": "MoM",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 150,
          "y": 230,
          "type": "file"
        },
        {
          "x": 390,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MoM-Setup.exe",
      "shortcutName": "MoM"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
