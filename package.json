{
  "name": "mom-todo",
  "productName": "MoM",
  "version": "1.0.0",
  "description": "A little robot that lives in the corner of your screen and holds your to-do list.",
  "main": "src/main.js",
  "author": "Subhan Sajadi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.subhansajadi.mom",
    "productName": "MoM",
    "copyright": "Copyright \u00a9 2026 Subhan Sajadi",
    "directories": {
      "output": "dist.nosync",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "MoM-${version}-mac.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MoM-Setup-${version}.exe",
      "shortcutName": "MoM"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
